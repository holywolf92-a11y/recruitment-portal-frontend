{
  "manifest_version": 3,
  "name": "Falisha — Send to Falisha",
  "version": "1.0.0",
  "description": "One-click CV import from rozeegpt.ai into your Falisha portal.",
  "permissions": ["storage", "scripting", "notifications", "webRequest", "downloads"],
  "host_permissions": [
    "https://*.rozeegpt.ai/*",
    "https://api.rozeegpt.ai/*",
    "https://glorious-flexibility-production.up.railway.app/*",
    "https://falishajobs.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Send to Falisha",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.rozeegpt.ai/*"],
      "js": ["content/injector.js"],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
